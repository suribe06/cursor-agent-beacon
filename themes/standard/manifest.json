{
  "id": "standard",
  "name": "Beacon Eyes",
  "description": "Default expressive-eye GIFs bundled with the repository",
  "license": "MIT",
  "author": "cursor-agent-beacon",
  "display": {
    "width": 480,
    "height": 480,
    "format": "gif",
    "background": "#071020",
    "target": "viewe-480"
  },
  "display_mode": "gif",
  "states": {
    "idle": {
      "animation": "assets/sleeping.gif",
      "loop": true,
      "caption": "Idle \u2014 eyes drift shut"
    },
    "waiting": {
      "animation": "assets/waiting.gif",
      "loop": true,
      "caption": "Happy eyes, glance, blink"
    },
    "thinking": {
      "animation": "assets/thinking.gif",
      "loop": true,
      "caption": "Eyes look up and around"
    },
    "running_shell": {
      "animation": "assets/running_shell.gif",
      "loop": true,
      "caption": "Narrow eyes scanning"
    },
    "running_mcp": {
      "animation": "assets/running_mcp.gif",
      "loop": true,
      "caption": "Steady eyes, green spark"
    },
    "success": {
      "animation": "assets/success.gif",
      "loop": true,
      "caption": "Smile that pulses"
    },
    "error": {
      "animation": "assets/error.gif",
      "loop": true,
      "caption": "Shock, then a sweat drop"
    },
    "stop": {
      "animation": "assets/stop.gif",
      "loop": false,
      "caption": "Laughing eyes"
    }
  }
}
