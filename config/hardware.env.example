# VIEWE UEDX48480021 — copy to config/hardware.env
#
# 2.1″ circular ESP32-S3 panel (see docs/hardware-viewe.md).
# SKU may be labeled MD80E or MD80ET; firmware board macro is MD80ET (touch init).
# Other displays: docs/hardware.md — same env vars, your own firmware.
#
# Linux USB-CDC (typical): /dev/ttyACM0
# Prefer USB-C→USB-A direct (avoid docks). User must be in group dialout.

CURSOR_AGENT_BEACON_HTTP_URL=http://127.0.0.1:8765/status
CURSOR_AGENT_BEACON_SERIAL_PORT=/dev/ttyACM0
CURSOR_AGENT_BEACON_SERIAL_BAUD=115200
CURSOR_AGENT_BEACON_THEME=standard
CURSOR_AGENT_BEACON_THEMES_DIR=themes
